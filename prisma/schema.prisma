// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuario {
  codigo String @id @default(uuid())
  nome   String
  senha  String
}

model Empresa {
  codigo        String     @id @default(uuid())
  razaoSocial   String     @unique
  nomeFantasia  String
  cnpj          String     @unique
  dataCriacao   DateTime   @default(now())
  dataAlteracao DateTime   @default(now())
  pacientes     Paciente[]
}

model Agendamento {
  cpf           String   @id @default(uuid())
  nome          String
  nomeEmpresa   String
  tipoConsulta  String
  data          String
  horario       String
  dataCriacao   DateTime @default(now())
  dataAlteracao DateTime @default(now())
}

model Paciente {
  codigo      String  @id @default(uuid())
  nome        String
  cpf         String  @unique
  contato     String
  empresaId   String
  cidade      String?
  bairro      String?
  estado      String?
  endereco    String?
  numero      String?
  complemento String?
  empresa     Empresa @relation(fields: [empresaId], references: [codigo])
}
